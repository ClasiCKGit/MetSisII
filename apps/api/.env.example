DATABASE_URL="postgresql://fitmanager_user:fitmanager_pwd@localhost:5433/fitmanager_db?schema=public"
PORT=3000
JWT_SECRET=
NODE_ENV=development
# false en producción para que nadie pueda crear gimnasios por su cuenta
REGISTRO_GIMNASIOS_HABILITADO=true
# Zona horaria IANA de los gimnasios: define qué es "el mes" en las métricas del inicio
ZONA_HORARIA=America/Argentina/Buenos_Aires
RESEND_API_KEY=
# Mientras no haya dominio propio verificado en Resend, usar el de prueba
MAIL_FROM=FitManager <onboarding@resend.dev>
FRONTEND_URL=http://localhost:5173